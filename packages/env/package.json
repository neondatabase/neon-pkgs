{
	"name": "@neon/env",
	"version": "1.0.0",
	"description": "Resolve and inject Neon connection strings for the branch selected by your neon.ts policy. fetchEnv / parseEnv plus a `neon-env` CLI with `run` and `export`.",
	"keywords": [
		"neon",
		"database",
		"postgres",
		"env",
		"dotenv",
		"platform"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/neondatabase/neon-pkgs.git"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Neon",
		"url": "https://neon.com"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"neon-env": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"README.md",
		"dist/",
		"package.json"
	],
	"scripts": {
		"build": "node ../../scripts/sync-shared.mjs . && tsc --noEmit && tsdown",
		"prepare": "npm run build",
		"test": "node ../../scripts/sync-shared.mjs . && pnpm --filter @neon/env... build && vitest --passWithNoTests",
		"test:ci": "node ../../scripts/sync-shared.mjs . && vitest run --passWithNoTests",
		"test:types": "node ../../scripts/sync-shared.mjs . && vitest run --typecheck.enabled --typecheck.only",
		"test:e2e": "node ../../scripts/sync-shared.mjs . && vitest run --config vitest.e2e.config.ts",
		"tsc": "tsc"
	},
	"devDependencies": {
		"@neon/e2e-harness": "workspace:*",
		"@neon/sdk": "workspace:*",
		"@types/node": "catalog:",
		"@types/yargs": "^17.0.35",
		"@vitest/coverage-v8": "catalog:",
		"console-fail-test": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@neon/config": "workspace:*",
		"zod": "^4.4.3",
		"yargs": "^18.0.0"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"publishConfig": {
		"provenance": false
	}
}
