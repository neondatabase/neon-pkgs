{
	"name": "get-db",
	"version": "0.14.2",
	"description": "[DEPRECATED] This package has been renamed to 'neon-new'. Please use 'neon-new' instead.",
	"keywords": [
		"neon",
		"database",
		"postgres",
		"cli",
		"deprecated"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/neondatabase/neon-pkgs.git"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Neon",
		"url": "https://neon.com"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"get-db": "dist/cli.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./sdk": {
			"import": "./dist/lib/index.js",
			"types": "./dist/lib/index.d.ts"
		},
		"./launchpad": {
			"import": "./dist/lib/index.js",
			"types": "./dist/lib/index.d.ts"
		}
	},
	"files": [
		"README.md",
		"dist/",
		"package.json"
	],
	"scripts": {
		"build": "tsc --noEmit && tsdown",
		"test": "pnpm --filter get-db... build && vitest --passWithNoTests",
		"test:ci": "vitest run --passWithNoTests",
		"tsc": "tsc"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"publishConfig": {
		"provenance": false
	},
	"dependencies": {
		"neon-new": "workspace:*"
	},
	"deprecated": "This package has been renamed to 'neon-new'. Please update your dependencies."
}
