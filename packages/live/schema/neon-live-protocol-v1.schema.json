{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neon.tech/schemas/live/neon-live-protocol-v1.schema.json",
  "title": "Neon Live protocol v1",
  "type": "object",
  "$defs": {
    "u64": {
      "type": "string",
      "$comment": "Canonical decimal integer in the inclusive range 1..2^64-1.",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "i32": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "publicationId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "heartbeatToken": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]{1,64}$"
    },
    "rowKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base64Cell": {
      "type": "object",
      "required": ["base64"],
      "properties": {
        "base64": {
          "$comment": "Canonical RFC 4648 base64, including zero padding bits.",
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$"
        }
      },
      "additionalProperties": false
    },
    "cell": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "$ref": "#/$defs/base64Cell" }
      ]
    },
    "row": {
      "type": "object",
      "required": ["row_key", "values"],
      "properties": {
        "row_key": { "$ref": "#/$defs/rowKey" },
        "values": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": ["name", "type_oid", "typmod", "codec"],
      "properties": {
        "name": { "type": "string" },
        "type_oid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "typmod": { "$ref": "#/$defs/i32" },
        "codec": { "enum": ["pg_text", "bytes"] }
      },
      "additionalProperties": false
    },
    "mvcc": {
      "type": "object",
      "required": ["xmin", "xmax", "xip"],
      "properties": {
        "xmin": { "$ref": "#/$defs/u64" },
        "xmax": { "$ref": "#/$defs/u64" },
        "xip": { "type": "array", "items": { "$ref": "#/$defs/u64" } }
      },
      "additionalProperties": false
    },
    "changeTarget": {
      "type": "object",
      "required": ["live_id", "epoch", "sequence"],
      "properties": {
        "live_id": { "$ref": "#/$defs/u64" },
        "epoch": { "$ref": "#/$defs/u64" },
        "sequence": { "$ref": "#/$defs/u64" }
      },
      "additionalProperties": false
    },
    "resetTarget": {
      "type": "object",
      "required": ["live_id", "epoch", "first_sequence"],
      "properties": {
        "live_id": { "$ref": "#/$defs/u64" },
        "epoch": { "$ref": "#/$defs/u64" },
        "first_sequence": { "$ref": "#/$defs/u64" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "discriminator": { "propertyName": "op" },
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "row_key", "values"],
          "properties": {
            "op": { "const": "upsert" },
            "row_key": { "$ref": "#/$defs/rowKey" },
            "values": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "row_key"],
          "properties": {
            "op": { "const": "remove" },
            "row_key": { "$ref": "#/$defs/rowKey" }
          },
          "additionalProperties": false
        }
      ]
    },
    "clientMessage": {
      "type": "object",
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "request_id", "authorization"],
          "properties": {
            "type": { "const": "subscribe" },
            "request_id": { "$ref": "#/$defs/u64" },
            "authorization": { "type": "string", "minLength": 1, "maxLength": 262144 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id", "authorization"],
          "properties": {
            "type": { "const": "renew" },
            "live_id": { "$ref": "#/$defs/u64" },
            "authorization": { "type": "string", "minLength": 1, "maxLength": 262144 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id"],
          "properties": {
            "type": { "const": "unsubscribe" },
            "live_id": { "$ref": "#/$defs/u64" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "token"],
          "properties": {
            "type": { "enum": ["ping", "pong"] },
            "token": { "$ref": "#/$defs/heartbeatToken" }
          },
          "additionalProperties": false
        }
      ]
    },
    "serverMessage": {
      "type": "object",
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "ready" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "request_id", "live_id", "epoch", "first_sequence", "columns"],
          "properties": {
            "type": { "const": "subscribed" },
            "request_id": { "$ref": "#/$defs/u64" },
            "live_id": { "$ref": "#/$defs/u64" },
            "epoch": { "$ref": "#/$defs/u64" },
            "first_sequence": { "$ref": "#/$defs/u64" },
            "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "request_id", "code", "message"],
          "properties": {
            "type": { "const": "subscribe_rejected" },
            "request_id": { "$ref": "#/$defs/u64" },
            "code": {
              "enum": ["authorization_failed", "authorization_expired", "backend_unavailable", "upstream_rejected", "resource_exhausted", "service_unavailable"]
            },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id"],
          "properties": {
            "type": { "enum": ["renewed", "unsubscribed"] },
            "live_id": { "$ref": "#/$defs/u64" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id", "epoch", "snapshot_attempt", "mvcc"],
          "properties": {
            "type": { "const": "snapshot_start" },
            "live_id": { "$ref": "#/$defs/u64" },
            "epoch": { "$ref": "#/$defs/u64" },
            "snapshot_attempt": { "$ref": "#/$defs/u64" },
            "mvcc": { "$ref": "#/$defs/mvcc" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id", "epoch", "snapshot_attempt", "index", "rows"],
          "properties": {
            "type": { "const": "snapshot_chunk" },
            "live_id": { "$ref": "#/$defs/u64" },
            "epoch": { "$ref": "#/$defs/u64" },
            "snapshot_attempt": { "$ref": "#/$defs/u64" },
            "index": { "$ref": "#/$defs/u32" },
            "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id", "epoch", "snapshot_attempt", "chunk_count"],
          "properties": {
            "type": { "const": "snapshot_end" },
            "live_id": { "$ref": "#/$defs/u64" },
            "epoch": { "$ref": "#/$defs/u64" },
            "snapshot_attempt": { "$ref": "#/$defs/u64" },
            "chunk_count": { "$ref": "#/$defs/u32" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "publication_id"],
          "properties": {
            "type": { "const": "open" },
            "publication_id": { "$ref": "#/$defs/publicationId" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "publication_id", "index", "txids", "targets", "changes"],
          "properties": {
            "type": { "const": "keyed_results" },
            "publication_id": { "$ref": "#/$defs/publicationId" },
            "index": { "$ref": "#/$defs/u32" },
            "txids": { "type": "array", "items": { "$ref": "#/$defs/u64" } },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/changeTarget" } },
            "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "publication_id", "index", "targets"],
          "properties": {
            "type": { "const": "reset_required" },
            "publication_id": { "$ref": "#/$defs/publicationId" },
            "index": { "$ref": "#/$defs/u32" },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/resetTarget" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "publication_id", "body_count", "frontier"],
          "properties": {
            "type": { "const": "commit" },
            "publication_id": { "$ref": "#/$defs/publicationId" },
            "body_count": { "$ref": "#/$defs/u32" },
            "frontier": {
              "type": "object",
              "required": ["lsn"],
              "properties": {
                "lsn": { "type": "string", "pattern": "^(0|[1-9A-F][0-9A-F]{0,7})/(0|[1-9A-F][0-9A-F]{0,7})$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id", "code", "message"],
          "properties": {
            "type": { "const": "subscription_error" },
            "live_id": { "$ref": "#/$defs/u64" },
            "code": {
              "enum": ["authorization_expired", "renewal_failed", "key_retired", "upstream_cancelled", "snapshot_failed", "protocol_error"]
            },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "code", "message"],
          "properties": {
            "type": { "const": "connection_error" },
            "code": {
              "enum": ["protocol_error", "invalid_payload", "message_too_large", "resource_exhausted", "slow_consumer", "heartbeat_timeout", "backend_session_lost", "backend_protocol_error", "fence_failed", "internal_error"]
            },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "token"],
          "properties": {
            "type": { "enum": ["ping", "pong"] },
            "token": { "$ref": "#/$defs/heartbeatToken" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/clientMessage" },
    { "$ref": "#/$defs/serverMessage" }
  ]
}
