// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`output schema codegen > emits loose result schemas in dependency order 1`] = `
"// This file is auto-generated by scripts/generate-tools.mjs. Do not edit.
// Schemas of each operation's success response, for tool output schemas.

import * as z from "zod";
import { credential, jsonSafeBlob, noContent } from "../lib/output.js";

export const zItem = z.looseObject({ id: z.string(), name: z.string().nullish(), status: z.string(), kind: z.literal("item"), count: z.number().nullish(), tags: z.array(z.string()).nullish(), labels: z.looseObject({ owner: z.string().nullish() }).catchall(z.string()).nullish(), password: credential(z.string()) });

export const zExtended = z.looseObject({ id: z.string(), name: z.string().nullish(), status: z.string(), kind: z.literal("item"), count: z.number().nullish(), tags: z.array(z.string()).nullish(), labels: z.looseObject({ owner: z.string().nullish() }).catchall(z.string()).nullish(), password: credential(z.string()), extra: z.boolean() });

export const zOther = z.looseObject({ other: z.number().nullish() });

export const zChoice = z.union([zItem, zOther]);

export const zCounts = z.record(z.string(), z.number());

/** The data schema of each operation's result, by operation id. */
export const operationOutputs = {
	getItem: zItem,
	deleteItem: noContent,
	updateItem: zExtended.nullable(),
	downloadItem: jsonSafeBlob,
	listItems: z.looseObject({ items: z.array(zChoice), counts: zCounts.nullish() }),
} as const;
"
`;
