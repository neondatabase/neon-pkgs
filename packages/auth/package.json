{
	"name": "@neon/auth",
	"version": "0.5.0-beta",
	"description": "TypeScript SDK for Neon Auth - authentication for PostgreSQL with multiple adapter support",
	"keywords": [
		"neon",
		"neondb",
		"postgresql",
		"postgres",
		"authentication",
		"auth",
		"typescript",
		"sdk",
		"better-auth",
		"supabase",
		"react",
		"nextjs"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/neondatabase/neon-pkgs.git",
		"directory": "packages/auth"
	},
	"homepage": "https://github.com/neondatabase/neon-pkgs/tree/main/packages/auth#readme",
	"bugs": {
		"url": "https://github.com/neondatabase/neon-pkgs/issues"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Neon",
		"url": "https://neon.com"
	},
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"neon-auth-codemod": "./codemods/migrate-auth-ui-imports.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"default": "./dist/types/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"default": "./dist/react/index.js"
		},
		"./react/adapters": {
			"types": "./dist/react/adapters/index.d.ts",
			"default": "./dist/react/adapters/index.js"
		},
		"./vanilla": {
			"types": "./dist/vanilla/index.d.ts",
			"default": "./dist/vanilla/index.js"
		},
		"./vanilla/adapters": {
			"types": "./dist/vanilla/adapters/index.d.ts",
			"default": "./dist/vanilla/adapters/index.js"
		},
		"./next": {
			"types": "./dist/next/index.d.ts",
			"default": "./dist/next/index.js"
		},
		"./next/server": {
			"types": "./dist/next/server/index.d.ts",
			"default": "./dist/next/server/index.js"
		},
		"./server": {
			"types": "./dist/server/index.d.ts",
			"default": "./dist/server/index.js"
		}
	},
	"files": [
		"README.md",
		"dist/",
		"package.json",
		"llms.txt",
		"BUILDING-AN-ADAPTER.md",
		"NEXT-JS.md",
		"codemods/migrate-auth-ui-imports.mjs"
	],
	"scripts": {
		"build": "tsc --noEmit && tsdown",
		"prepare": "npm run build",
		"test": "vitest",
		"test:node": "node --run test",
		"test:ci": "vitest run --passWithNoTests",
		"tsc": "tsc"
	},
	"devDependencies": {
		"@neon-internals/internal": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"msw": "2.6.8",
		"next": "16.2.11",
		"rolldown": "1.2.8",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@better-fetch/fetch": "1.3.1",
		"@supabase/auth-js": "2.79.0",
		"better-auth": "1.6.23",
		"jose": "6.2.5",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0",
		"next": ">=16.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"next": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"publishConfig": {
		"provenance": false
	}
}
