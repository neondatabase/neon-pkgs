# Copy to `.env` and fill in real values. `.env` itself is gitignored.
# The repository root is the normal place for this file — every live e2e
# suite reads it, so you configure credentials once. A `.env` next to a package
# overrides the root one, and real environment variables beat both.
#
# Required to run `pnpm --filter @neon/auth test:e2e`.
#
# The suite creates a REAL Neon project, enables Neon Auth on its default branch,
# and deletes both when the run ends. It also sweeps every stale `neon-ts-e2e-*`
# project the key can see. Point it at a throwaway org only — never a personal
# or production one. The key must be able to create projects, so a project-scoped
# key cannot run this suite.

# Organization-scoped API key for the throwaway org. Required.
NEON_API_KEY=

# The throwaway org. Recommended, and required in practice for a user-scoped
# key: without it the cleanup sweep ranges over every org the key can see.
NEON_ORG_ID=

# Point the whole run at a non-production API. Optional.
# Defaults to https://console.neon.tech/api/v2
NEON_API_BASE_URL=
