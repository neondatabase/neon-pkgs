{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neon.tech/schemas/realtime/realtime-query-capability-v3.schema.json",
  "title": "Neon Realtime query capability v3",
  "description": "Strict decoded HPKE envelope protected-header and claims contract. Compact serialization and cryptographic requirements are recorded in x-hpkeCompact. Duplicate or unknown keys are rejected at every level.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protected", "claims"],
  "properties": {
    "protected": { "$ref": "#/$defs/protectedHeader" },
    "claims": { "$ref": "#/$defs/claims" }
  },
  "x-hpkeCompact": {
    "serialization": "compact",
    "segments": 5,
    "layout": [
      "base64url(protected)",
      "base64url(enc)",
      "",
      "base64url(ciphertext || tag)",
      ""
    ],
    "base64url": "RFC 4648 section 5 without padding. Decoders reject padding, characters outside the alphabet, and non-zero unused trailing bits.",
    "protectedSerialization": "{\"alg\":\"HPKE-P256-SHA256-A256GCM\",\"kid\":\"<kid>\",\"v\":3}",
    "hpke": {
      "rfc": 9180,
      "mode": 0,
      "kemId": 16,
      "kdfId": 1,
      "aeadId": 2,
      "sequenceNumber": 0
    },
    "info": "ASCII(neon-realtime/envelope/v3)",
    "aad": "ASCII(base64url(protected))",
    "encBytes": 65,
    "encFormat": "uncompressed SEC1 P-256 point: 0x04 || X || Y",
    "tagBytes": 16,
    "minCiphertextBytes": 17,
    "plaintext": "UTF-8 JSON claims",
    "defaultMaxTokenBytes": 262144,
    "absoluteMaxTokenBytes": 1048576
  },
  "$defs": {
    "databaseName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[^\\x00]+$",
      "x-maxUtf8Bytes": 63
    },
    "roleName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[^\\x00]+$",
      "x-maxUtf8Bytes": 63
    },
    "keyId": {
      "description": "16 bytes, base64url without padding.",
      "type": "string",
      "minLength": 22,
      "maxLength": 22,
      "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
    },
    "releaseLine": {
      "type": "string",
      "$comment": "Canonical major or major.minor release cohort. Servers map unrecognized lines to a bounded unknown telemetry bucket.",
      "maxLength": 16,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?$"
    },
    "protectedHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "kid", "v"],
      "properties": {
        "alg": { "const": "HPKE-P256-SHA256-A256GCM" },
        "kid": { "$ref": "#/$defs/keyId" },
        "v": { "const": 3 }
      }
    },
    "issuerMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdk", "release_line", "query_source"],
      "properties": {
        "sdk": { "const": "javascript" },
        "release_line": { "$ref": "#/$defs/releaseLine" },
        "query_source": { "enum": ["raw_sql", "drizzle", "kysely", "custom"] }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "type_oid": {
          "description": "Optional PostgreSQL type hint. Omission or zero requests SQL-context inference.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "value": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "maxLength": 21848,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
              "x-maxUtf8Bytes": 21848,
              "x-decodedMaxBytes": 16384
            }
          ]
        }
      }
    },
    "auth": {
      "description": "Postgres login the proxy checks before admitting the query.",
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "credential"],
      "properties": {
        "user": {
          "description": "The Postgres role to log in as.",
          "$ref": "#/$defs/roleName"
        },
        "credential": {
          "description": "A password or an OIDC JWT. The proxy does not tell them apart.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^[^\\x00]+$",
          "x-maxUtf8Bytes": 16384
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "aud",
        "database",
        "error_details",
        "issuer",
        "query_fingerprint",
        "sql",
        "parameters",
        "iat",
        "exp",
        "auth"
      ],
      "properties": {
        "v": { "const": 3 },
        "aud": { "const": "realtime-proxy" },
        "database": { "$ref": "#/$defs/databaseName" },
        "error_details": {
          "description": "Controls whether subscription errors use safe client-facing messages or include full database diagnostics.",
          "enum": ["safe", "full"]
        },
        "issuer": { "$ref": "#/$defs/issuerMetadata" },
        "query_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64,
          "x-maxUtf8Bytes": 64
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072,
          "x-maxUtf8Bytes": 131072
        },
        "parameters": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "auth": { "$ref": "#/$defs/auth" }
      },
      "x-invariants": [
        "0 < exp - iat <= 300",
        "iat <= now + 30",
        "now < exp",
        "complete Subscribe protobuf payload <= 65536 bytes at request_id = uint64::MAX"
      ]
    }
  }
}
