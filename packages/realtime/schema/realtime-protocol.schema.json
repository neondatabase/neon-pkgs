{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neon.tech/schemas/realtime/realtime-protocol-v3.schema.json",
  "title": "Neon Realtime protocol v3",
  "type": "object",
  "$defs": {
    "u64": {
      "type": "string",
      "$comment": "Canonical decimal integer in the inclusive range 1..2^64-1.",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "i32": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "sqlstate": { "type": "string", "pattern": "^[0-9A-Z]{5}$" },
    "publicationId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "heartbeatToken": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]{1,64}$"
    },
    "releaseLine": {
      "type": "string",
      "$comment": "Canonical major or major.minor release cohort. Servers map unrecognized lines to a bounded unknown telemetry bucket.",
      "maxLength": 16,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?$"
    },
    "rowKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "segmentTag": {
      "type": "string",
      "$comment": "The 32-byte digest that names a multi-row segment, as lowercase hex. Opaque to applications.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "round": {
      "$ref": "#/$defs/u64",
      "$comment": "Identifies one recomputation of a live ID's result. A new round of the same live ID gets a new value."
    },
    "selector": {
      "type": "object",
      "$comment": "One segment a selected round replaces: a multi-row segment by tag, or a one-row segment by its row key.",
      "oneOf": [
        {
          "required": ["tag"],
          "properties": { "tag": { "$ref": "#/$defs/segmentTag" } },
          "additionalProperties": false
        },
        {
          "required": ["row_key"],
          "properties": { "row_key": { "$ref": "#/$defs/rowKey" } },
          "additionalProperties": false
        }
      ]
    },
    "scope": {
      "type": "object",
      "$comment": "What a round replaces. 'all' replaces the whole result; 'selected' replaces the named segments, including those that turn out empty. An absent scope never means 'all'.",
      "discriminator": { "propertyName": "kind" },
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "all" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "selectors"],
          "properties": {
            "kind": { "const": "selected" },
            "selectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selector" } }
          },
          "additionalProperties": false
        }
      ]
    },
    "covered": {
      "type": "object",
      "$comment": "The change sequences a round resolves: from the live ID's first unresolved hole through the tick of the round's snapshot. Semantic validation requires first_sequence <= last_sequence.",
      "required": ["first_sequence", "last_sequence"],
      "properties": {
        "first_sequence": { "$ref": "#/$defs/u64" },
        "last_sequence": { "$ref": "#/$defs/u64" }
      },
      "additionalProperties": false
    },
    "base64Cell": {
      "type": "object",
      "required": ["base64"],
      "properties": {
        "base64": {
          "$comment": "Canonical RFC 4648 base64, including zero padding bits.",
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$"
        }
      },
      "additionalProperties": false
    },
    "cell": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "$ref": "#/$defs/base64Cell" }
      ]
    },
    "row": {
      "type": "object",
      "required": ["row_key", "values"],
      "properties": {
        "row_key": { "$ref": "#/$defs/rowKey" },
        "values": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
        "segment_tag": { "$ref": "#/$defs/segmentTag" }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": ["name", "type_oid", "typmod", "codec"],
      "properties": {
        "name": { "type": "string" },
        "type_oid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "typmod": { "$ref": "#/$defs/i32" },
        "codec": { "enum": ["pg_text", "bytes"] }
      },
      "additionalProperties": false
    },
    "mvcc": {
      "type": "object",
      "$comment": "Visibility evidence for known committed transactions. Semantic validation requires xmin <= xmax and every xip entry in [xmin, xmax).",
      "required": ["xmin", "xmax", "xip"],
      "properties": {
        "xmin": { "$ref": "#/$defs/u64" },
        "xmax": { "$ref": "#/$defs/u64" },
        "xip": { "type": "array", "items": { "$ref": "#/$defs/u64" } }
      },
      "additionalProperties": false
    },
    "changeTarget": {
      "type": "object",
      "required": ["live_id", "epoch", "sequence"],
      "properties": {
        "live_id": { "$ref": "#/$defs/u64" },
        "epoch": { "$ref": "#/$defs/u64" },
        "sequence": { "$ref": "#/$defs/u64" }
      },
      "additionalProperties": false
    },
    "resetTarget": {
      "type": "object",
      "required": ["live_id", "epoch", "first_sequence"],
      "properties": {
        "live_id": { "$ref": "#/$defs/u64" },
        "epoch": { "$ref": "#/$defs/u64" },
        "first_sequence": { "$ref": "#/$defs/u64" }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "discriminator": { "propertyName": "op" },
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "row_key", "values"],
          "properties": {
            "op": { "const": "upsert" },
            "row_key": { "$ref": "#/$defs/rowKey" },
            "values": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
            "segment_tag": { "$ref": "#/$defs/segmentTag" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "row_key"],
          "properties": {
            "op": { "const": "remove" },
            "row_key": { "$ref": "#/$defs/rowKey" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "$comment": "Sequentially splice row_key immediately after after_row_key; null means head. Contents precede moves. Every ordered patch entrant must have its own move, including a new tail row. Materialized programs containing moves validate entrants against prior membership; content-only programs do not reveal whether the query is ordered. Raw receivers validate structure without retaining membership. Each moved key and final predecessor occurs at most once; a moved anchor must be placed earlier. Both keys must exist in the final result. Expose only at Commit.",
          "required": ["op", "row_key", "after_row_key"],
          "properties": {
            "op": { "const": "move" },
            "row_key": { "$ref": "#/$defs/rowKey" },
            "after_row_key": {
              "oneOf": [
                { "$ref": "#/$defs/rowKey" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "clientMessage": {
      "type": "object",
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        {
          "type": "object",
          "$comment": "Bounded, extensible connection metadata encoded as JSON. A v2 client must send this exactly once after Ready and before any subscription command.",
          "required": ["type", "metadata"],
          "properties": {
            "type": { "const": "client_info" },
            "metadata": { "type": "string", "minLength": 2, "maxLength": 4096 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "request_id", "authorization"],
          "properties": {
            "type": { "const": "subscribe" },
            "request_id": { "$ref": "#/$defs/u64" },
            "authorization": { "type": "string", "minLength": 1, "maxLength": 262144 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id", "authorization"],
          "properties": {
            "type": { "const": "renew" },
            "live_id": { "$ref": "#/$defs/u64" },
            "authorization": { "type": "string", "minLength": 1, "maxLength": 262144 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id"],
          "properties": {
            "type": { "const": "unsubscribe" },
            "live_id": { "$ref": "#/$defs/u64" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "token"],
          "properties": {
            "type": { "enum": ["ping", "pong"] },
            "token": { "$ref": "#/$defs/heartbeatToken" }
          },
          "additionalProperties": false
        }
      ]
    },
    "serverMessage": {
      "type": "object",
      "discriminator": { "propertyName": "type" },
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "ready" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "request_id", "live_id", "epoch", "first_sequence", "columns"],
          "properties": {
            "type": { "const": "subscribed" },
            "request_id": { "$ref": "#/$defs/u64" },
            "live_id": { "$ref": "#/$defs/u64" },
            "epoch": { "$ref": "#/$defs/u64" },
            "first_sequence": { "$ref": "#/$defs/u64" },
            "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "request_id", "code", "message"],
          "properties": {
            "type": { "const": "subscribe_rejected" },
            "request_id": { "$ref": "#/$defs/u64" },
            "code": {
              "enum": ["authorization_failed", "authorization_expired", "backend_unavailable", "backend_overloaded", "upstream_rejected", "resource_exhausted", "service_unavailable"]
            },
            "message": { "type": "string" },
            "sqlstate": { "$ref": "#/$defs/sqlstate" },
            "retry_after_ms": { "$ref": "#/$defs/u32" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id"],
          "properties": {
            "type": { "enum": ["renewed", "unsubscribed"] },
            "live_id": { "$ref": "#/$defs/u64" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "$comment": "Starts one attempt of a round, sent with the round's first batch. A higher baseline_sync_attempt of the same round supersedes the earlier attempt. A different round in the same epoch starts only after the previous round's baseline_sync_end, unless reset_required changed the epoch first. A selected round arrives while the live ID is live, in its current epoch, and carries covered; a round that starts an epoch carries none.",
          "required": ["type", "live_id", "epoch", "baseline_sync_attempt", "round", "scope", "mvcc"],
          "properties": {
            "type": { "const": "baseline_sync_start" },
            "live_id": { "$ref": "#/$defs/u64" },
            "epoch": { "$ref": "#/$defs/u64" },
            "baseline_sync_attempt": { "$ref": "#/$defs/u64" },
            "round": { "$ref": "#/$defs/round" },
            "scope": { "$ref": "#/$defs/scope" },
            "mvcc": { "$ref": "#/$defs/mvcc" },
            "covered": { "$ref": "#/$defs/covered" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "$comment": "Batch indices start at 0 in each attempt.",
          "required": ["type", "live_id", "epoch", "baseline_sync_attempt", "round", "index", "rows"],
          "properties": {
            "type": { "const": "baseline_sync_batch" },
            "live_id": { "$ref": "#/$defs/u64" },
            "epoch": { "$ref": "#/$defs/u64" },
            "baseline_sync_attempt": { "$ref": "#/$defs/u64" },
            "round": { "$ref": "#/$defs/round" },
            "index": { "$ref": "#/$defs/u32" },
            "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id", "epoch", "baseline_sync_attempt", "round", "batch_count"],
          "properties": {
            "type": { "const": "baseline_sync_end" },
            "live_id": { "$ref": "#/$defs/u64" },
            "epoch": { "$ref": "#/$defs/u64" },
            "baseline_sync_attempt": { "$ref": "#/$defs/u64" },
            "round": { "$ref": "#/$defs/round" },
            "batch_count": { "$ref": "#/$defs/u32" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "publication_id"],
          "properties": {
            "type": { "const": "open" },
            "publication_id": { "$ref": "#/$defs/publicationId" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "publication_id", "index", "txids", "targets", "changes"],
          "properties": {
            "type": { "const": "keyed_results" },
            "publication_id": { "$ref": "#/$defs/publicationId" },
            "index": { "$ref": "#/$defs/u32" },
            "txids": { "type": "array", "items": { "$ref": "#/$defs/u64" } },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/changeTarget" } },
            "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "$comment": "A publication body that commits a hole: some of each target's rows for this tick arrive later, in a round. It lists no segments and does not change the epoch. Every keyed_results and segments_pending body for one live ID in one publication carries the same sequence and the same txids, and a target has at most one hole body per publication. The sequence advances once, at commit. segments_pending and reset_required never target the same live ID in one publication.",
          "required": ["type", "publication_id", "index", "txids", "targets"],
          "properties": {
            "type": { "const": "segments_pending" },
            "publication_id": { "$ref": "#/$defs/publicationId" },
            "index": { "$ref": "#/$defs/u32" },
            "txids": { "type": "array", "items": { "$ref": "#/$defs/u64" } },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/changeTarget" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "publication_id", "index", "targets"],
          "properties": {
            "type": { "const": "reset_required" },
            "publication_id": { "$ref": "#/$defs/publicationId" },
            "index": { "$ref": "#/$defs/u32" },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/resetTarget" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "publication_id", "body_count", "frontier"],
          "properties": {
            "type": { "const": "commit" },
            "publication_id": { "$ref": "#/$defs/publicationId" },
            "body_count": { "$ref": "#/$defs/u32" },
            "frontier": {
              "type": "object",
              "required": ["lsn"],
              "properties": {
                "lsn": { "type": "string", "pattern": "^(0|[1-9A-F][0-9A-F]{0,7})/(0|[1-9A-F][0-9A-F]{0,7})$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "live_id", "code", "message"],
          "properties": {
            "type": { "const": "subscription_error" },
            "live_id": { "$ref": "#/$defs/u64" },
            "code": {
              "enum": ["authorization_expired", "renewal_failed", "upstream_cancelled", "backend_overloaded", "baseline_sync_failed", "protocol_error"]
            },
            "message": { "type": "string" },
            "sqlstate": { "$ref": "#/$defs/sqlstate" },
            "retry_after_ms": { "$ref": "#/$defs/u32" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "code", "message"],
          "properties": {
            "type": { "const": "connection_error" },
            "code": {
              "enum": ["protocol_error", "invalid_payload", "message_too_large", "resource_exhausted", "slow_consumer", "heartbeat_timeout", "backend_session_lost", "backend_protocol_error", "fence_failed", "internal_error"]
            },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "$comment": "Non-terminal client warning. The connection and subscriptions remain usable.",
          "required": ["type", "code", "message"],
          "properties": {
            "type": { "const": "client_warning" },
            "code": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "token"],
          "properties": {
            "type": { "enum": ["ping", "pong"] },
            "token": { "$ref": "#/$defs/heartbeatToken" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "$comment": "Ordered installed-processing progress, shared by the connection's subscriptions. Covered changes must precede this message; subscriptions may apply the proof only after their baseline and covered changes are installed.",
          "required": ["type", "mvcc"],
          "properties": {
            "type": { "const": "progress" },
            "mvcc": { "$ref": "#/$defs/mvcc" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/clientMessage" },
    { "$ref": "#/$defs/serverMessage" }
  ]
}
