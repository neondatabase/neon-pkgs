# Copy to `.env` and fill in real values. `.env` itself is gitignored.
# The repository root is the normal place for this file — all five live e2e
# suites read it, so you configure credentials once. A `.env` next to a package
# overrides the root one, and real environment variables beat both.
#
# Required to run `pnpm --filter @neon/config-runtime test:e2e`.
#
# These suites create and delete REAL Neon projects, and delete every stale
# `neon-ts-e2e-*` project the key can see. Point them at a throwaway org only —
# never a personal or production one. The org must be on the Launch plan or
# above; one test protects a branch, which the free plan disallows.

# Organization-scoped API key for the throwaway org. Required.
NEON_API_KEY=

# The throwaway org. Recommended, and required in practice for a user-scoped
# key: without it the cleanup sweep ranges over every org the key can see.
NEON_ORG_ID=

# Only for project-scoped keys, which cannot create projects. Tests that need
# to create one skip themselves and use this project instead.
NEON_PROJECT_ID=

# Point the whole run at a non-production API. Optional.
# Defaults to https://console.neon.tech/api/v2
NEON_API_BASE_URL=
