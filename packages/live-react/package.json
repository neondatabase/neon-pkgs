{
  "name": "@neon/live-react",
  "version": "0.0.0",
  "description": "React integration for Neon Live queries.",
  "keywords": [
    "neon",
    "database",
    "postgres",
    "live-query",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neondatabase/neon-pkgs.git",
    "directory": "packages/live-react"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Neon",
    "url": "https://neon.com"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist/",
    "package.json"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "prepare": "npm run build",
    "test": "vitest --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@neon/live": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "catalog:",
    "console-fail-test": "catalog:",
    "jsdom": "^29.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@neon/live": "^0.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "provenance": false
  }
}
