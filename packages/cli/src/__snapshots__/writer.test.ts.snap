// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`writer > outputs json > outputs multiple data 1`] = `
"{
  "t1": {
    "foo": "bar"
  },
  "t2": {
    "baz": "xyz"
  }
}
"
`;

exports[`writer > outputs json > outputs single data 1`] = `
"{
  "foo": "bar"
}
"
`;

exports[`writer > outputs json > outputs single data with title 1`] = `
"{
  "foo": "bar"
}
"
`;

exports[`writer > outputs yaml > outputs multiple data 1`] = `
"t1:
  foo: bar
t2:
  baz: xyz
"
`;

exports[`writer > outputs yaml > outputs single data 1`] = `
"foo: bar
"
`;

exports[`writer > outputs yaml > outputs single data with title 1`] = `
"foo: bar
"
`;
