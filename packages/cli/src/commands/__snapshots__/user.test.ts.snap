"{
  "id": "1",
  "name": "John Doe",
  "email": "john@example.com"
}
"
`;

exports[`me > names the --api-key credential in the table 1`] = `
"Email           john@example.com
Name            John Doe
Authentication  API key (--api-key)
"
`;
