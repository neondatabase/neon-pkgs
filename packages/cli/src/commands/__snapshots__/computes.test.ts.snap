exports[`postgres computes > list --branch resolves the branch name and lists its computes 1`] = `
"Computes on test_branch
ID                   Branch ID               Type
ep-cool-king-930914  br-sunny-branch-123456  read_write
ep-cool-king-933333  br-sunny-branch-123456  read_only
"
`;

exports[`postgres computes > list without a branch lists every compute in the project 1`] = `
"- id: ep-test
  created_at: 2019-01-01T00:00:00Z
  type: read_only
"
`;

