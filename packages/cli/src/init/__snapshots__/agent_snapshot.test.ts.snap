"exit: 0
--- stdout ---
{
  "phase": "migrations",
  "status": "found",
  "detected": {
    "tool": "prisma",
    "migrationDir": null
  },
  "nextAction": {
    "type": "ask_user",
    "question": "Found prisma migrations. Would you like to apply them to your Neon database?",
    "options": [
      {
        "value": "apply",
        "label": "Yes, apply migrations"
      },
      {
        "value": "skip",
        "label": "Skip for now"
      }
    ],
    "responseMapping": {
      "apply": {
        "command": "neon init --agent --data '{\\"step\\":\\"migrations\\",\\"apply\\":true,\\"tool\\":\\"prisma\\"}'"
      },
      "skip": {
