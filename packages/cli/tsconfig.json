{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "strict": true,
    "outDir": "./dist",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      // `@neon/sdk` ships its raw layer via the `@neon/sdk/raw` subpath export.
      // Classic ("node") module resolution ignores package `exports`, so map the
      // specifiers to their shipped types here for the type-checker; Node honors
      // the export map at runtime (the emitted JS keeps the bare specifiers).
      "@neon/sdk": ["node_modules/@neon/sdk/dist/index"],
      "@neon/sdk/raw": ["node_modules/@neon/sdk/dist/raw"],
      // And for `@neon/config/v1`, the versioned policy surface. `@neon-internals/env-core`
      // imports it, and that code is bundled into this package.
      "@neon/config/v1": ["node_modules/@neon/config/dist/v1"],
      "@neon/e2e-harness": ["node_modules/@neon/e2e-harness/src/index"],
      // Same reason for the private internals, which are bundled into this package:
      // classic resolution ignores their `exports` map. tsdown resolves them itself.
      "@neon-internals/cli-core/*": ["node_modules/@neon-internals/cli-core/dist/*"],
      "@neon-internals/env-core/*": ["node_modules/@neon-internals/env-core/dist/*"]
    },
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts"]
}
