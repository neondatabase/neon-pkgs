{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "strict": true,
    "outDir": "./dist",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      // `@neon/sdk` ships its raw layer via the `@neon/sdk/raw` subpath export.
      // Classic ("node") module resolution ignores package `exports`, so map the
      // specifiers to their shipped types here for the type-checker; Node honors
      // the export map at runtime (the emitted JS keeps the bare specifiers).
      "@neon/sdk": ["node_modules/@neon/sdk/dist/index"],
      "@neon/sdk/raw": ["node_modules/@neon/sdk/dist/raw"],
      // And for `@neon/env/runtime`, the stateful half of `@neon/env` (credential
      // reuse / revocation), which is a subpath export so an app importing
      // `@neon/env` is never offered it.
      "@neon/env/runtime": ["node_modules/@neon/env/dist/runtime"],
      // And for `@neon/functions/hono`, the Hono binding, which is a subpath
      // export so importing `@neon/functions` never reaches for `hono`.
      "@neon/functions/hono": ["node_modules/@neon/functions/dist/hono"],
      "@neon/e2e-harness": ["node_modules/@neon/e2e-harness/src/index"]
    },
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts"]
}
